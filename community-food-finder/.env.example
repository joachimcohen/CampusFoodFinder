# ============================================================
# Supabase — MUST be a fresh, standalone Supabase project.
# Never point this at the Campus Food Finder project (spec Section 1).
# Project Settings -> API in the Supabase dashboard.
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-side only, NEVER prefix with NEXT_PUBLIC_, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================
# Session secrets — any long random string, generate with:
#   openssl rand -base64 32
# Use a DIFFERENT value for each of these three.
# ============================================================
ORG_SESSION_SECRET=
ADMIN_DEVICE_SECRET=

# ============================================================
# Instance / branding config (Section 1, 2, 8) — this is the block that
# changes to fork this template for a different council/region. Suburb data
# itself lives in the database (supabase/migrations/0001_init.sql seed), not here.
# ============================================================
NEXT_PUBLIC_LOCALITY_NAME=Whitehorse
NEXT_PUBLIC_LOCALITY_FULL_NAME=Whitehorse City Council
NEXT_PUBLIC_TIMEZONE=Australia/Melbourne
NEXT_PUBLIC_REGION_SLUG=whitehorse
NEXT_PUBLIC_MAP_DEFAULT_LAT=-37.8199
NEXT_PUBLIC_MAP_DEFAULT_LNG=145.1226

# ============================================================
# PTV Timetable API (Section 7.2) — optional for launch. Nearest-stop info
# just won't show until these are set. Request a free developer key by
# emailing APIKeyRequest@ptv.vic.gov.au (Section 9 — confirm turnaround time
# before committing to this for launch).
# ============================================================
PTV_DEV_ID=
PTV_API_KEY=

# ============================================================
# Web Push (Section 6 — "Secure your place" queue notifications). Optional:
# the live status page works without it. Generate a VAPID key pair with:
#   npx web-push generate-vapid-keys
# ============================================================
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.org

# ============================================================
# Optional — authenticates the daily keep-alive cron (any random string)
# ============================================================
CRON_SECRET=
